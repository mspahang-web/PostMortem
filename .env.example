VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Email pattern for sport login IDs ({id} = lowercase login ID,
# e.g. OLAHRAGA -> mspahang+olahraga@gmail.com).
# Must match the emails of the users in Supabase Auth.
VITE_LOGIN_EMAIL_TEMPLATE=mspahang+{id}@gmail.com
